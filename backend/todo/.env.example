# MongoDB
# MONGO_PASSWORD is used by docker-compose to build the full connection URI.
MONGO_PASSWORD=your-mongo-password-here

# For local dev without Docker, set the full URI directly.
# When running via docker-compose this is overridden automatically.
SPRING_MONGODB_URI=mongodb://root:your-mongo-password-here@localhost:27017/taskflow?authSource=admin

# JWT
# Must be at least 256 bits of random data. Generate with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-here

# Reset token TTL — 5 minutes (300 000 ms)
RESET_TOKEN_EXPIRATION_MS=300000

# Infobip — email/4/messages JSON endpoint
# Base URL is your account-specific subdomain (e.g. https://xxxxx.api.infobip.com)
# Find it at: https://portal.infobip.com/homepage under API base URL
INFOBIP_API_KEY=your-infobip-api-key-here
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
MAIL_FROM=your-verified-sender@yourdomain.com

# Password reset OTP TTL (minutes)
PASSWORD_RESET_CODE_TTL_MINUTES=15

# Server
SERVER_PORT=8080

# Telemetry -> Alloy -> Loki. Loki, Alloy, and Grafana run in the same
# compose project as the backend, so the endpoint is hardcoded to the
# alloy service name in docker-compose.yml (no override needed here).
# OTEL_ENVIRONMENT tags logs with a deployment label.
OTEL_ENVIRONMENT=local
